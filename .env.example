# =============================================================================
# IETDS - Integrated Email Threat Detection System
# Environment configuration template.
# Copy this file to ".env" and fill in real values for local development.
# NEVER commit the real ".env" file to version control.
# =============================================================================

# --- Core Flask settings -----------------------------------------------------
FLASK_ENV=development
FLASK_DEBUG=1
# Random, long, unpredictable string. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-64-char-hex-string

# --- Database -----------------------------------------------------------------
# SQLite for local development (default). Flask-SQLAlchemy resolves a relative
# sqlite:/// path against the app's instance/ folder automatically, so
# "sqlite:///ietds.db" becomes instance/ietds.db - do not prefix it with
# "instance/" yourself or it will look for instance/instance/ietds.db.
# Swap to a PostgreSQL URL in production, e.g.
# postgresql+psycopg2://user:password@host:5432/ietds
DATABASE_URL=sqlite:///ietds.db

# --- Credential encryption ------------------------------------------------------
# Fernet key used to encrypt mailbox passwords / OAuth tokens at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-this-to-a-generated-fernet-key

# --- Gmail OAuth 2.0 (optional; required only for Gmail mailbox connections) ---
# See docs/oauth-setup.md for the full step-by-step Google Cloud Console walkthrough
# (create project -> enable Gmail API -> OAuth consent screen -> create OAuth client ID).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:5000/mailboxes/oauth/gmail/callback

# Microsoft 365/Outlook (Graph API) support was removed from this deployment -
# see docs/limitations.md. Gmail OAuth and generic IMAP are the two supported
# mailbox connection paths tested for this project.

# --- Background worker ---------------------------------------------------------
# APScheduler runs in-process by default (no external broker required).
# If you later scale up to Celery, set these and switch SCHEDULER_BACKEND=celery.
SCHEDULER_BACKEND=apscheduler
REDIS_URL=redis://localhost:6379/0

# --- Application behaviour ------------------------------------------------------
DEMO_MODE=1
DEFAULT_SCAN_INTERVAL_MINUTES=5
SESSION_COOKIE_SECURE=0
TIMEZONE=Africa/Lagos
